# Professional root-level .htaccess for CodeIgniter API
# - Secure sensitive paths
# - Normalize URLs
# - Route all app traffic through index.php
# - Apply secure headers and caching rules

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Normalize URL path: remove duplicate slashes
    RewriteCond %{REQUEST_URI} ^(.+)//+(.*)$
    RewriteRule .* %1/%2 [L,R=301]

    # Remove trailing slash for non-directory requests
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} .+/$
    RewriteRule ^(.+)/$ $1 [L,R=301]

    # Route swagger UI and docs through the front controller.
    RewriteRule ^(swagger|docs)(/.*)?$ index.php/$1$2 [L,QSA]

    # Deny access to sensitive directories and files
    RewriteRule ^(?:application|system|vendor|db|documents|docs|\.git)(?:/|$) - [F,NC,L]
    RewriteRule ^(?:composer\.json|composer\.lock|README\.md|LICENSE|\.env)(?:$|/) - [F,NC,L]

    # Route requests to front controller when resource not found
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    Header always unset X-Powered-By
</IfModule>

# Optional HTTPS enforcement (uncomment when SSL is available)
#<IfModule mod_rewrite.c>
#    RewriteCond %{HTTPS} !=on
#    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresDefault "access plus 1 hour"
</IfModule>

# Deny direct access to hidden files and dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Disable ETags to prevent cache validation issues
FileETag None




